# MediGem workstation (frontend_v2)

# Pipeline API, see backend/api/app.py. Start it with:
#   uvicorn backend.api.app:app --port 8000
# Leave unset to run the workstation on bundled demo data only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Upper bound for one analysis request (ms). A full run is ~10-20 s on an M-series laptop.
NEXT_PUBLIC_API_TIMEOUT=120000

# Only when the API sets MEDIGEM_API_KEY. This value ships in the browser
# bundle; it deters casual abuse, the server's rate limit is the control.
# NEXT_PUBLIC_API_KEY=

# Server-side only: used by app/api/assistant/route.ts.
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=gemma3:4b
MEDIGEM_API_URL=http://localhost:8000
# MEDIGEM_API_KEY=
